#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # i8kutils is a different, older Dell fan-control tool that also manages
    # dell_smm_hwmon. We don't hard-Conflict on it (both can be installed at
    # once, and their modprobe.d files no longer collide by path), but running
    # both daemons/services at the same time can still fight over fan control,
    # so just warn rather than block the install.
    if dpkg -l i8kutils 2>/dev/null | grep -q '^ii'; then
        echo "g15-fanctl: note: i8kutils is also installed and manages the same" >&2
        echo "  dell_smm_hwmon kernel module. Running both at once can cause" >&2
        echo "  fan control to fight between the two tools. If you only want" >&2
        echo "  to use g15-fanctl, consider: sudo apt remove i8kutils" >&2
    fi

    # Try to bind dell_smm_hwmon immediately so fan RPM/control is available
    # without requiring a reboot.
    if command -v modprobe >/dev/null 2>&1; then
        modprobe dell_smm_hwmon force=1 fan_mult=1 fan_max=3 2>/dev/null || true
    fi
fi

# The block below is auto-generated by debhelper (dh_installsystemd) and
# handles enabling/starting/restarting g15-fancontrold.service.
#DEBHELPER#

exit 0
