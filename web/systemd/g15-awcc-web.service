[Unit]
Description=Dell G15 AWCC Web Frontend
Documentation=https://github.com/Durgesh-Kumar-Dewangan/Dell_G15_AWCC
After=network.target g15-fancontrold.service
Wants=g15-fancontrold.service

[Service]
Type=simple
User=%u
WorkingDirectory=%h/Dell_G15_AWCC/web
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/usr/local/sbin"
Environment="NODE_ENV=production"
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=g15-awcc-web

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=%h/Dell_G15_AWCC/web/.next

[Install]
WantedBy=multi-user.target
